# SatQuery AI — Unified Environment Variables Template
# Copy this file to .env before deploying or running docker-compose

# ==============================================================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite / React)
# ==============================================================================
# Base URL for the Spring Boot Orchestrator Gateway API
# In development: http://localhost:8080 | In production: https://api.yourdomain.com
VITE_SPRING_BOOT_API_URL=http://localhost:8080

# Optional Cesium Ion Default Access Token for high-resolution 3D global terrain/photogrammetry
# If omitted, SatQuery AI automatically falls back to open ESRI World Imagery
VITE_CESIUM_ION_ACCESS_TOKEN=

# Optional Google Gemini API Key for client-side multimodal reasoning
VITE_GEMINI_API_KEY=

# Optional Colab ML Inference Server endpoint (if running external GPU PyTorch container)
VITE_COLAB_INFERENCE_URL=

# ==============================================================================
# 2. SPRING BOOT BACKEND GATEWAY
# ==============================================================================
# Port for the Java Spring Boot Gateway service
SERVER_PORT=8080

# Microservice downstream endpoints (Docker network service names or localhost)
NLP_SERVICE_URL=http://nlp-service:8001
DATA_SERVICE_URL=http://data-service:8002
EO_SERVICE_URL=http://eo-analysis-service:8003

# ==============================================================================
# 3. NLP SERVICE (FastAPI / Python)
# ==============================================================================
# Port for the NLP service
PORT=8001

# NLP Provider selection: 'rule_based' (built-in fast regex/heuristics) | 'gemini' | 'openai'
LLM_PROVIDER=rule_based

# API Keys (required only if LLM_PROVIDER is set to external provider)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ==============================================================================
# 4. DATA SERVICE (FastAPI / PostGIS Spatial Service)
# ==============================================================================
# Port for the Data service
PORT=8002

# PostgreSQL / PostGIS connection string
DATABASE_URL=postgresql://satquery:earthpass@postgres:5432/satquery_db

# ==============================================================================
# 5. EO ANALYSIS SERVICE (FastAPI / Spectral Math Service)
# ==============================================================================
# Port for the EO analysis service
PORT=8003

# ==============================================================================
# 6. POSTGRES / POSTGIS DATABASE
# ==============================================================================
POSTGRES_USER=satquery
POSTGRES_PASSWORD=earthpass
POSTGRES_DB=satquery_db
POSTGRES_PORT=5432
