# Data Service Dockerfile — build context is the repo root (see docker-compose.yml / render.yaml)
FROM python:3.11-slim
WORKDIR /app
COPY services/data-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY services/data-service/ .
# Bundled so the service can self-apply the PostGIS schema/seed data on first boot
# (see app/repositories/spatial_repository.py::_apply_migrations).
COPY database/migrations /app/migrations
EXPOSE 8002
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port \"${PORT:-8002}\""]
